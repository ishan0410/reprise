# Copy to .env and fill in. Never commit .env.

# Primary discovery-loop provider (vision + tool calling)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Fallback provider, used automatically when Gemini returns a rate-limit (429) error
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Set to 1 only if GROQ_MODEL can accept images; otherwise the fallback reasons over the accessibility tree alone.
GROQ_VISION=0

# Local mock target application
TARGET_APP_PORT=4000
TARGET_APP_URL=http://localhost:4000

# Demo-only fixture credentials for the local mock app (not real secrets).
# The agent only ever sees these as {{secret:...}} references; values are resolved at action time
# and never reach the LLM, the artifact, or the logs.
TARGET_USERNAME=teller1
TARGET_PASSWORD=demo-pass-2024
